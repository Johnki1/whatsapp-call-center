# ============================================================
# BotWap — /opt/botwap/.env (Fase 7C-2)
# ============================================================
# GENERADO POR ANSIBLE — NO editar manualmente en el servidor.
# Los valores provienen de Azure Key Vault (leídos con la
# Managed Identity de la VM). Permisos 0600, propietario root.
#
# Docker Compose usa este archivo para sustituir las variables
# ${VAR} declaradas en docker-compose.yml.
# ============================================================

# ===== Perfil de la aplicación =====
SPRING_PROFILES_ACTIVE=meta
BOT_WHATSAPP_CLIENT=meta

# ===== PostgreSQL =====
POSTGRES_USER=botwap
POSTGRES_DB=botwap
POSTGRES_PASSWORD={{ kv_secrets['postgres-password'] }}

# ===== WhatsApp Cloud API (Meta) =====
WHATSAPP_ACCESS_TOKEN={{ kv_secrets['whatsapp-access-token'] }}
WHATSAPP_APP_SECRET={{ kv_secrets['whatsapp-app-secret'] }}
WHATSAPP_VERIFY_TOKEN={{ kv_secrets['whatsapp-verify-token'] }}
WHATSAPP_PHONE_NUMBER_ID={{ kv_secrets['whatsapp-phone-number-id'] }}
WHATSAPP_WABA_ID={{ kv_secrets['whatsapp-waba-id'] }}
WHATSAPP_APP_ID={{ kv_secrets['whatsapp-app-id'] }}
WHATSAPP_API_VERSION=v25.0
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com


# ===== Gemini AI (Fase V2, Key Vault) =====
GEMINI_API_KEY={{ kv_secrets['gemini-api-key'] }}
APP_GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3.5-flash-lite
