# ============================================================
# VALORES DE EJEMPLO — NUNCA pongas secretos reales aquí.
# Copia este archivo a `.env` y completa con tus valores locales.
# El archivo `.env` NO debe subirse a Git (.gitignore lo excluye).
# ============================================================

# ----- PostgreSQL -----
POSTGRES_USER=botwap
POSTGRES_PASSWORD=change_me_dev_password
POSTGRES_DB=botwap

# ----- Backend -----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Modo del cliente de WhatsApp: mock (default/desarrollo) | meta (producción)
BOT_WHATSAPP_CLIENT=mock

# ----- WhatsApp Cloud API (Meta) -----
# Se dejan vacíos hasta completar el registro en Meta (desarrollo con mock).
WHATSAPP_VERIFY_TOKEN=change_me_webhook_verify_token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v21.0
# Host de la Graph API (override para sandbox/pruebas locales; default: Meta).
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com
# Timeouts del cliente HTTP del backend hacia Meta, en milisegundos.
WHATSAPP_API_TIMEOUT_MS=10000
WHATSAPP_CONNECT_TIMEOUT_MS=5000